# Notion API credentials
# Get your token from https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID of your Notion database
# Found in the database URL: notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public app URL (used for redirects and meta)
NEXT_PUBLIC_APP_URL=http://localhost:3000
